# Copy this file to `.env` and fill in real values before running in
# anything beyond local development. Loaded via python-dotenv if you add
# `from dotenv import load_dotenv; load_dotenv()` to your process entrypoint,
# or export these directly in your shell / container / CI environment.

# --- Environment ---------------------------------------------------------
RIXOR_ENV=development

# --- Webhook authentication (Tier 1) --------------------------------------
# Payment gateway must send EITHER header with the matching value:
#   X-Webhook-Secret: <RIXOR_WEBHOOK_SECRET>
#   Authorization: Bearer <RIXOR_BEARER_TOKEN>
RIXOR_WEBHOOK_SECRET=change-me-in-production
RIXOR_BEARER_TOKEN=change-me-in-production

# --- In-memory cache sizing ------------------------------------------------
RIXOR_BUFFER_SIZE=100
RIXOR_IDEMPOTENCY_TTL=86400

# --- Ensemble weights (must sum to a positive number; auto-normalized) -----
RIXOR_W_ML=0.40
RIXOR_W_GRAPH=0.35
RIXOR_W_VELOCITY=0.15
RIXOR_W_RULES=0.10

# --- Policy thresholds ------------------------------------------------------
RIXOR_T_MONITOR=0.40
RIXOR_T_REVIEW=0.55
RIXOR_T_HOLD=0.75
RIXOR_T_BLOCK=0.88

# --- Regulatory constants (India RBI KYC) -----------------------------------
RIXOR_KYC_CEILING=50000
RIXOR_STRUCTURING_LOW=24000
RIXOR_STRUCTURING_HIGH=49999

# --- Firestore (optional cloud persistence) ---------------------------------
RIXOR_FIRESTORE_ENABLED=false
RIXOR_FIRESTORE_PROJECT=
RIXOR_FIRESTORE_DB=ai-studio-rixor-f2b6aa9a-b425-413c-b36c-a500ffa9e594

# --- ML model artifact -------------------------------------------------------
# Leave unset to use the default app/artifacts/model.pkl path.
RIXOR_MODEL_PATH=
